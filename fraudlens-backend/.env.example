# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=True

# Server settings
HOST=0.0.0.0
PORT=8000
SECRET_KEY=fraudlens-super-secret-production-key-change-in-prod-2026

# JWT Authentication
JWT_SECRET_KEY=fraudlens-jwt-secret-key-change-in-production-use-strong-entropy
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database
# For local development with zero setup, SQLite is supported:
DATABASE_URL=sqlite:///./fraudlens.db
# For PostgreSQL in Docker or Production:
# DATABASE_URL=postgresql://fraudlens_user:fraudlens_secure_pass_2026@localhost:5432/fraudlens_db

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# External APIs
# Google Gemini API for extraction and explainable summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# VirusTotal API for URL and domain security scans
VIRUSTOTAL_API_KEY=

# MCA Government of India API / provider (falls back to local sample dataset if blank)
MCA_API_URL=
MCA_API_KEY=

# LinkedIn Company Presence API (falls back to authorized domain verification if blank)
LINKEDIN_API_URL=
LINKEDIN_API_KEY=

# Security & Upload Limits
UPLOAD_MAX_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,webp,csv,xlsx
TEMP_UPLOAD_DIR=./temp_uploads
REPORTS_DIR=./generated_reports

# Rate Limiting (requests per minute)
RATE_LIMIT_AUTH=15
RATE_LIMIT_SCAM=30
RATE_LIMIT_UPI=20
